---
import type { Lang } from "@/i18n/translations";

interface Props {
  lang: Lang;
}

const { lang }: Props = Astro.props;

const base = import.meta.env.BASE_URL;
const enHref = base;
const frHref = `${base}fr/`;
---

<div
  class="fixed z-[110] top-6 right-6 bottom-auto md:top-6 md:right-6 lang-switcher-mobile"
>
  <div
    class="flex items-center gap-2 px-3 py-2 rounded-full border border-[var(--white-icon-tr)] bg-[var(--background)] backdrop-blur-xl shadow-lg"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width="16"
      height="16"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="text-[var(--white-icon)]"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path
        d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
      ></path>
    </svg>
    <a
      href={enHref}
      aria-label="English"
      class={`text-sm font-semibold tracking-wide transition-colors ${
        lang === "en" ? "text-[var(--sec)]" : "text-[var(--white-icon)] hover:text-white"
      }`}
    >
      EN
    </a>
    <span class="text-[var(--white-icon-tr)] text-sm">|</span>
    <a
      href={frHref}
      aria-label="Français"
      class={`text-sm font-semibold tracking-wide transition-colors ${
        lang === "fr" ? "text-[var(--sec)]" : "text-[var(--white-icon)] hover:text-white"
      }`}
    >
      FR
    </a>
  </div>
</div>

<style>
  @media (max-width: 767px) {
    .lang-switcher-mobile {
      top: 1rem;
      right: 1rem;
      bottom: auto;
    }
  }
</style>
