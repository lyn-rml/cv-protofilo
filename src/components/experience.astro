---
import type { ExperienceT } from "@/i18n/translations";

interface Props {
  t: ExperienceT;
}

const { t }: Props = Astro.props;
---

<section
  id="experience"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">{t.sectionLabel}</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-10">{t.title}</h3>

    <div class="relative border-l border-[var(--white-icon-tr)] pl-8 space-y-10 ml-2">
      {
        t.items.map((item) => (
          <div class="relative">
            <span class="absolute -left-[41px] top-1.5 w-4 h-4 rounded-full bg-[var(--sec)] ring-4 ring-[var(--background)]" />
            <div class="bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl p-5 md:p-6 hover:border-[var(--white-icon)] transition-colors duration-300">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-1 mb-1">
                <h4 class="text-xl md:text-2xl font-semibold">{item.role}</h4>
                <span class="text-sm text-[var(--white-icon)] whitespace-nowrap">
                  {item.period} · {item.duration}
                </span>
              </div>
              <p class="text-[var(--sec)] mb-4 text-sm md:text-base">
                {item.company} — {item.location}
              </p>
              <ul class="space-y-2 text-[var(--white-icon)] text-sm md:text-base">
                {item.bullets.map((b) => (
                  <li class="flex gap-2">
                    <span class="text-[var(--sec)] mt-1 flex-shrink-0">▹</span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
